# ==============================================================
# KONFIGURASI ENV - ABSENSI ROBOTIK MAN 19 JAKARTA
# ==============================================================

# Port server untuk pengujian lokal (Default: 3000)
PORT=3000

# PostgreSQL Connection String (Supabase / Neon / RDS)
# Contoh Supabase Transaction Pooler (Port 6543) atau Direct (Port 5432):
# postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:password_kamu@db.ref_supabase.supabase.co:5432/postgres?sslmode=require

# PIN / Password untuk masuk ke Dashboard Admin
ADMIN_PIN=ROBOTIK19

# Koordinat Pusat MAN 19 Jakarta
MAN19_LAT=-6.250529
MAN19_LON=106.757041

# Batas toleransi radius absensi (dalam satuan meter)
MAX_RADIUS_METERS=100
